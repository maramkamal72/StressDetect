# Copy this file to ".env" and edit it. ".env" is ignored by git.

# A long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Port for the website (5000 is used by AirPlay on a Mac)
# PORT=5001

# Leave unset to use SQLite. For MySQL (as in the project report):
# 1) CREATE DATABASE stressdetect CHARACTER SET utf8mb4;
# 2) uncomment and edit the next line
# DATABASE_URL=mysql+pymysql://root:your_password@localhost/stressdetect?charset=utf8mb4

# Set to 1 only when the site is served over HTTPS
# SESSION_COOKIE_SECURE=1

# Shown when stress is High. Put your university's real counselling contact here.
# SUPPORT_TEXT=Contact the University Counselling Centre at ... or emergency services if you are in danger.
